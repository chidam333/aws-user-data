[Unit]
Description=Immich Rclone Backup
Wants=network-online.target
After=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
User=home
EnvironmentFile=/etc/homelab/ntfy.env
EnvironmentFile=/etc/homelab/immich-backup.env
# A hung rclone is killed and treated as a failure (which alerts) instead of blocking forever
TimeoutStartSec=12h
StandardOutput=journal
StandardError=journal

ExecStart=/usr/local/bin/homelab/immich-backup/backup.sh
