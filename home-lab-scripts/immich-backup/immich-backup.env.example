# Installed to /etc/homelab/immich-backup.env (root-only).

# Immich's UPLOAD_LOCATION (contains library/, upload/, profile/, backups/)
IMMICH_UPLOAD_LOCATION=/home/home/immich-app/library

# rclone destination for the mirror, e.g. remote:immich/current
BACKUP_DEST=

# Locally deleted/overwritten files are moved here under a dated folder instead of being lost.
# Must be on the same rclone remote as BACKUP_DEST and not inside it, e.g. remote:immich/archive
BACKUP_ARCHIVE=

# Fail if Immich's newest DB dump is older than this
# DB_DUMP_MAX_AGE_HOURS=26
